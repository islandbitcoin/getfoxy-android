<?xml version="1.0" encoding="utf-8"?>
<!-- INTERNET is for Tor (in this process, tor-android) and Route, the one HTTP
     client (docs/ROUTE.md §5): every native request goes through Tor or, after
     a native dialog's yes, the open connection, or is refused. The page itself
     still has no network (docs/ROUTE.md §4: the asset loader, blocked network
     loads, a dead-end proxy). ACCESS_NETWORK_STATE is for NetworkKind: Tor is
     taken off the network while the phone has none.

     P3: CAMERA for the scanner and the live pane (asked on the first scan);
     POST_NOTIFICATIONS for "Payment sent"/"Payment received" (API 33+, asked on
     the first one); USE_BIOMETRIC for the PIN lock and the seed's device
     protection; DETECT_SCREEN_CAPTURE for `_screenshot` (API 34+). A camera is
     not required: a phone without one answers "No camera available."

     ENG-667: NFC for a card session (cardBegin): reader mode on the activity in
     front, only while the page has a session open (flashcard/ReaderModeRadio.kt).
     NFC is not required: a phone without it installs Foxy and the page is told
     "NFC is not available on this phone".

     ENG-668: a Flashcard held to the phone opens Foxy. The card's tag carries one
     NDEF URI record, https://getfoxy.io/card (getfoxy/card FOXY-CARD-SPEC.md, the
     NDEF file), and CardTapActivity filters Android's tag dispatch for exactly that
     address (NDEF_DISCOVERED; never TECH_ or TAG_DISCOVERED, ManifestTest), and
     the same address as a link (VIEW, BROWSABLE). The link filter is not verified
     (autoVerify false): an App Link needs getfoxy.io/.well-known/assetlinks.json
     with the release key's fingerprint, and there is no release key yet
     (docs/DEVICE-TESTS.md). Either way only CardAddress.isCard's exact address is
     acted on, and the page hears only that a card was tapped.

     The filters are not on MainActivity: singleTop reuses it only while it is the
     top of its task, and the scanner and the seed screens are started in that task
     over it, so a card held then would make a second MainActivity (a second page,
     PutAway and Tor install, its splash over the seed words). CardTapActivity draws
     nothing, keeps no history or Recents entry, has a task of its own, and decides
     (CardTapRoute): a new page, the page on top of its task handed the tap
     (singleTop, onNewIntent), or nothing while anything is over the page. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <uses-permission android:name="android.permission.NFC" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".FoxyApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Foxy.Starting"
        tools:targetApi="36">

        <!-- No Google services in the WebView (docs/ROUTE.md §4) -->
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|smallestScreenSize|density|fontScale"
            android:theme="@style/Theme.Foxy.Starting"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ENG-668: the door a Flashcard's address comes in by; draws nothing, finishes in onCreate (CardTapActivity) -->
        <activity
            android:name=".CardTapActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true">
            <!-- a Flashcard held to the phone: its tag's one address, and nothing else (CardAddress) -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="getfoxy.io" android:path="/card" />
            </intent-filter>
            <!-- the same address as a link; not verified until getfoxy.io publishes assetlinks.json for the release key -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="getfoxy.io" android:path="/card" />
            </intent-filter>
        </activity>

        <!-- P3: Foxy's own screens over the page, each FLAG_SECURE, none reachable from outside -->
        <activity
            android:name=".scanner.ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|smallestScreenSize|density|fontScale"
            android:theme="@style/Theme.Foxy.Screen"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <activity
            android:name=".seed.ShowWordsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|smallestScreenSize|density|fontScale"
            android:theme="@style/Theme.Foxy.Screen"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <activity
            android:name=".seed.EnterWordsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|smallestScreenSize|density|fontScale"
            android:theme="@style/Theme.Foxy.Screen"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
    </application>
</manifest>
